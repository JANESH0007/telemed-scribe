# =============================================================================
# TeleMed-Scribe — Environment Configuration
# =============================================================================
# Copy this to .env and adjust for your machine.

# --- Model Configuration ---
# Whisper model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL_SIZE=base
# Device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute type: int8 (fastest on CPU), float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8

# --- Translation ---
# NLLB-200 model (distilled-600M is ~1.2GB, practical for laptops)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=cpu
# Max tokens for translation output
TRANSLATION_MAX_LENGTH=512

# --- Audio Processing ---
# Target sample rate for STT models (16kHz is standard for Whisper)
TARGET_SAMPLE_RATE=16000
# Target channels (mono)
TARGET_CHANNELS=1
# Maximum audio duration in seconds (0 = no limit)
MAX_AUDIO_DURATION=600

# --- VAD ---
# Enable Voice Activity Detection filtering
VAD_ENABLED=true
# VAD threshold (0.0-1.0, higher = stricter)
VAD_THRESHOLD=0.5

# --- Evaluation ---
# Path to evaluation dataset
EVAL_DATA_DIR=evaluation_data

# --- Logging ---
LOG_LEVEL=INFO
